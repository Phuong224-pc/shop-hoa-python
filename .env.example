# =============================================================================
# FLORA FLOWER BOUTIQUE - ENVIRONMENT CONFIGURATION (.env)
# Hệ thống website bán hoa tươi trực tuyến Flask - Kiến trúc Large Application
# =============================================================================

# 1. Cấu hình cốt lõi Flask & Security
FLASK_APP=run.py
FLASK_CONFIG=development
FLASK_DEBUG=1
SECRET_KEY=flora-flower-secret-key-super-secure-change-in-production-2026
PORT=5000

# 2. Cơ sở dữ liệu SQLite / SQLAlchemy ORM
DATABASE_URL=sqlite:///db.sqlite3

# 3. Cấu hình gửi Email qua Flask-Mail (SMTP)
# Hướng dẫn: Nếu sử dụng Gmail SMTP, bật Xác thực 2 bước (2FA) trên tài khoản Google,
# tạo Mật khẩu ứng dụng (App Password 16 ký tự) tại myaccount.google.com/apppasswords
# rồi điền vào MAIL_PASSWORD bên dưới. Tuyệt đối không dùng mật khẩu Gmail chính.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER="Flora Flower Boutique <noreply@floraflower.vn>"

# 4. Email nhận thông báo đơn hàng của Chủ shop (Yêu cầu đồ án)
SHOP_NOTIFICATION_EMAIL=phuongtruong121204@gmail.com

# 5. Địa chỉ URL công khai (Phục vụ sinh token xác thực email và đặt lại mật khẩu)
PUBLIC_BASE_URL=http://127.0.0.1:5000
